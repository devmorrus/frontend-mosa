# Base URL of the MOSA backend API. Never hardcode this in source files —
# every environment (local, staging, production) supplies its own value.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Human-readable name of the current environment, shown in the UI (e.g. a
# "STAGING" badge) so nobody confuses environments by accident.
VITE_APP_ENV=local
